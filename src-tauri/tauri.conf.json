{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aetherium Cloud",
  "version": "0.1.0",
  "identifier": "net.aetherium.cloud.desktop",
  "build": {
    "frontendDist": "../src",
    "devUrl": "https://cloud.aetheriumos.com",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Aetherium Cloud",
        "width": 1500,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
